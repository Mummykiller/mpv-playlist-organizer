{
	"root": false,
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/utils/SystemLogger.js",
			"!**/utils/anilist_renderer.js",
			"!**/utils/commUtils.js",
			"!**/utils/security.js",
			"!**/utils/nativeConnection.js",
			"!**/utils/MpvInterface.js",
			"!**/utils/domUtils.js",
			"!**/testing_tools/scripts/bridge_contract.js",
			"!**/node_modules",
			"!**/testing_tools/node_modules",
			"!**/mcp_server/.venv",
			"!**/mpv-playlist-organizer-release",
			"!**/yt-tools-legacy",
			"!**/yt-tools-standalone",
			"!**/*.md",
			"!**/*.html"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		},
		"globals": ["chrome", "MPV_INTERNAL", "MPV_SECURITY"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "error"
			},
			"suspicious": {
				"useIterableCallbackReturn": "off"
			}
		}
	}
}
